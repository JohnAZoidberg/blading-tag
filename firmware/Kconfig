mainmenu "blading-tag"

menu "blading-tag"

config BLADING_BUFFER_SAMPLES
	int "Samples buffered on the tag"
	default 14336
	help
	  Samples the tag can hold while the link is down or too slow
	  (reported as buffer_capacity in Info). 12 bytes each; 14336 is
	  72 s at 200 Hz and takes 168 KB of the 256 KB RAM.

config BLADING_LINK_LOSS_STOP_S
	int "Stop recording after this long without a connection (s)"
	default 300

config BLADING_IDLE_SLEEP_S
	int "Go to System OFF after this long idle (s), 0 = never"
	default 0
	help
	  Idle means READY, not connected and no motion. Only applies when the
	  ADXL367 works, since motion is what wakes the tag again.
	  Off by default until System OFF and wake-on-motion are verified on
	  the tag (see firmware/README.md); the plan is 600.

config BLADING_MOTION_THRESHOLD_MG
	int "Wake-on-motion threshold (mg)"
	default 150
	range 10 2000

config BLADING_LOW_BATTERY_MV
	int "Status LOW_BATTERY below this voltage (mV)"
	default 2500

config BLADING_TEST_HOOKS
	bool "Hooks for the hardware tests (test builds only)"
	help
	  A RAM mailbox that a J-Link writes commands into, e.g. "short
	  button press", for host/tests/hw. Polls every 20 ms, so it costs
	  power: only for test builds (make build-test, test.conf).

endmenu

source "Kconfig.zephyr"
